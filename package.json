{
  "name": "trace-platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:cultivar": "npm run dev --workspace=packages/cultivar-os",
    "dev:ignition": "npm run dev --workspace=packages/ignition-os",
    "dev:trace": "npm run dev --workspace=packages/trace-app",
    "build:cultivar": "npm run build --workspace=packages/cultivar-os",
    "build:ignition": "npm run build --workspace=packages/ignition-os",
    "build:trace": "npm run build --workspace=packages/trace-app",
    "verify:universals": "node scripts/verify-universals.mjs",
    "verify:write-wall": "set -o pipefail; node_modules/.bin/esbuild scripts/verify-write-wall.ts --bundle --platform=node --format=cjs --external:@supabase/supabase-js --external:@anthropic-ai/sdk | node",
    "lint": "eslint \"packages/**/*.{ts,tsx,js,jsx}\"",
    "knip": "knip",
    "quality:gate": "node scripts/quality-gate.mjs",
    "quality:baseline": "node scripts/quality-gate.mjs --update",
    "test": "node scripts/run-tests.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks && echo \"core.hooksPath = .githooks\"",
    "hooks:status": "git config core.hooksPath >/dev/null 2>&1 && echo \"hooks ON  -> $(git config core.hooksPath)  (pre-commit + pre-merge-commit: verify-handoff-retention)\" || echo 'hooks OFF -> not installed in this clone. Run: npm run hooks:install'",
    "verify:rls": "node scripts/run-rls-tests.mjs",
    "verify": "npm run verify:conflict-markers && npm run verify:address-fields && node scripts/verify-api-parses.mjs && npm run verify:api-types && npm run verify:embed-ambiguity && npm run verify:customer-name-fields && npm run verify:snapshot-fresh && npm run verify:migration-header-truth && npm run verify:stable-paging && node scripts/quality-gate.mjs && npm run verify:universals && npm run verify:select-policies && npm run verify:write-paths && npm run verify:zero-row-writes && npm run verify:field-lists && npm run verify:customer-address-columns && npm run verify:tile-fields && npm run verify:profile-boundary && npm run verify:authority && npm run verify:unit-projection && npm run verify:handoff-retention && npm run verify:register-blocks && npm run verify:ui-divergence && npm run verify:owner-boards && npm run verify:pricing-writers && npm run verify:owner-id-repoint && npm run verify:id-citations && npm run verify:id-sweep && npm run verify:main-ancestry && npm run verify:migration-apply-state && npm run verify:exec-output && npm run verify:writer-registry && npm run verify:search-registry && npm run verify:zero-seeded-fees && npm run verify:notes-before-drop && npm run verify:undo-test-edits && npm test",
    "verify:select-policies": "node scripts/verify-select-policies.mjs",
    "verify:write-paths": "node scripts/verify-write-paths.mjs",
    "write-paths:baseline": "node scripts/verify-write-paths.mjs --update",
    "verify:zero-row-writes": "node scripts/verify-zero-row-writes.mjs",
    "zero-row-writes:baseline": "node scripts/verify-zero-row-writes.mjs --update",
    "verify:authority": "node scripts/verify-authority-checks.mjs",
    "verify:unit-projection": "node scripts/verify-unit-projection.mjs",
    "units:backfill": "node_modules/.bin/esbuild scripts/backfill-inventory-units.ts --bundle --platform=node --format=cjs --external:@supabase/supabase-js --outfile=node_modules/.cache/backfill-units.cjs && node node_modules/.cache/backfill-units.cjs",
    "authority:baseline": "node scripts/verify-authority-checks.mjs --baseline",
    "verify:field-lists": "node scripts/verify-field-lists.mjs",
    "verify:tile-fields": "node scripts/verify-tile-fields.mjs",
    "verify:profile-boundary": "node scripts/verify-profile-writer-boundary.mjs",
    "field-lists:baseline": "node scripts/verify-field-lists.mjs --update",
    "verify:address-fields": "node scripts/verify-address-fields.mjs --self-test && node scripts/verify-address-fields.mjs",
    "verify:conflict-markers": "node scripts/verify-conflict-markers.mjs && node scripts/verify-conflict-markers.mjs --self-test",
    "verify:api-parses": "node scripts/verify-api-parses.mjs",
    "verify:api-types": "node scripts/verify-api-types.mjs && node scripts/verify-api-types.mjs --self-test",
    "verify:embed-ambiguity": "node scripts/verify-embed-ambiguity.mjs && node scripts/verify-embed-ambiguity.mjs --self-test",
    "verify:customer-name-fields": "node scripts/verify-customer-name-fields.mjs && node scripts/verify-customer-name-fields.mjs --self-test",
    "verify:undo-test-edits": "node scripts/sql-harness/undo-test-mode-edits-348.pglite.mjs",
    "verify:zero-seeded-fees": "node scripts/sql-harness/zero-seeded-fees-357.pglite.mjs",
    "verify:notes-before-drop": "node scripts/sql-harness/notes-before-drop-346.pglite.mjs",
    "verify:writer-registry": "node scripts/verify-writer-registry.mjs && node scripts/verify-writer-registry.mjs --self-test",
    "verify:search-registry": "node scripts/verify-search-registry.mjs && node scripts/verify-search-registry.mjs --self-test",
    "verify:handoff-retention": "node scripts/verify-handoff-retention.mjs && node scripts/verify-handoff-retention.mjs --self-test",
    "verify:register-blocks": "node scripts/verify-register-blocks.mjs && node scripts/verify-register-blocks.mjs --self-test",
    "verify:ui-divergence": "node scripts/verify-ui-standard-divergence.mjs",
    "verify:owner-boards": "node scripts/verify-owner-test-boards.mjs",
    "verify:pricing-writers": "node scripts/verify-pricing-config-writers.mjs && node scripts/verify-pricing-config-writers.mjs --self-test",
    "verify:owner-id-repoint": "node scripts/verify-owner-id-repoint.mjs && node scripts/verify-owner-id-repoint.mjs --self-test",
    "verify:id-citations": "node scripts/verify-id-citations.mjs && node scripts/verify-id-citations.mjs --self-test",
    "verify:customer-address-columns": "node scripts/verify-customer-address-columns.mjs && node scripts/verify-customer-address-columns.mjs --self-test",
    "verify:id-sweep": "node scripts/verify-id-sweep.mjs",
    "migration:slot": "node scripts/list-migration-slot.mjs",
    "verify:merge-landed": "node scripts/verify-merge-landed.mjs",
    "id-citations:baseline": "node scripts/verify-id-citations.mjs --update",
    "verify:migration-apply-state": "node scripts/verify-migration-apply-state.mjs --self-test",
    "verify:main-ancestry": "node scripts/verify-main-ancestry.mjs && node scripts/verify-main-ancestry.mjs --self-test",
    "verify:stable-paging": "node scripts/verify-stable-paging.mjs && node scripts/verify-stable-paging.mjs --self-test",
    "verify:snapshot-fresh": "node scripts/verify-snapshot-fresh.mjs && node scripts/verify-snapshot-fresh.mjs --self-test",
    "geocode:backfill": "node_modules/.bin/esbuild scripts/geocode-backfill.ts --bundle --platform=node --format=cjs --external:@supabase/supabase-js --outfile=node_modules/.cache/geocode-backfill.cjs && node node_modules/.cache/geocode-backfill.cjs",
    "geocode:business": "node_modules/.bin/esbuild scripts/geocode-business-address.ts --bundle --platform=node --format=cjs --external:@supabase/supabase-js --outfile=node_modules/.cache/geocode-business.cjs && node node_modules/.cache/geocode-business.cjs",
    "verify:migration-header-truth": "node scripts/verify-migration-header-truth.mjs && node scripts/verify-migration-header-truth.mjs --self-test",
    "verify:exec-output": "node scripts/selftest/exec-output-regression.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@types/jsdom": "^30.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  }
}
